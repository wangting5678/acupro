---
import "../styles.css";
import { CONTACT } from "../data";

export interface Props {
  title: string;
  description?: string;
  canonicalPath: string;
}
const { title, description = "", canonicalPath } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, "") ?? "https://acuproclinic.co.uk";
const canonical = site + (canonicalPath === "/" ? "" : canonicalPath) + "/";

const localBusiness = {
  "@context": "https://schema.org",
  "@type": "MedicalClinic",
  name: "AcuPro Clinic",
  description: "Acupuncture & Traditional Chinese Medicine clinic in London.",
  url: site,
  telephone: CONTACT.phone,
  email: CONTACT.email,
  medicalSpecialty: "Alternative",
  address: [
    { "@type": "PostalAddress", streetAddress: "10 Buckingham Palace Rd", addressLocality: "London", postalCode: "SW1W 0QP", addressCountry: "GB" },
    { "@type": "PostalAddress", streetAddress: "33-34 Bury Street", addressLocality: "London", postalCode: "EC3A 5AR", addressCountry: "GB" },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Consent Mode v2 default (GDPR/PECR): deny tracking until the visitor accepts. Must run BEFORE GTM. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      (function(){var c;try{c=localStorage.getItem('acupro_consent');}catch(e){}var ok=c==='granted';
        gtag('consent','default',{ad_storage:ok?'granted':'denied',analytics_storage:ok?'granted':'denied',ad_user_data:ok?'granted':'denied',ad_personalization:ok?'granted':'denied',wait_for_update:500});})();
    </script>
    <!-- Google Tag Manager (container GTM-WC78T4W — GA4 + Google Ads AW-834082397 + Meta Pixel live inside it, managed by the marketing agency) -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-WC78T4W');</script>
    <!-- End Google Tag Manager -->
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/acupro-logo.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="AcuPro Clinic" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WC78T4W" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <header class="site-header">
      <div class="container nav">
        <a href="/" class="brand" aria-label="AcuPro Clinic home"><img src="/acupro-logo.png" alt="AcuPro Clinic" class="brand-logo" /></a>
        <nav class="nav-links">
          <a href="/#services">Services</a>
          <a href="/conditions/">Conditions</a>
          <a href="/our-team/">Our Team</a>
          <a href="/pricing/">Pricing</a>
          <a href="/#clinics">Branches</a>
        </nav>
        <div class="nav-cta">
          <button id="langToggle" class="lang-btn" style="display:none" aria-label="Switch language">العربية</button>
          <span class="region-pill" id="regionPill">🇬🇧 UK</span>
          <a href="/book/" class="btn btn-primary">Book Now</a>
        </div>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <div class="brand" style="color:#fff;margin-bottom:14px"><span class="brand-mark">A</span> AcuPro&nbsp;<span class="brand-clinic">CLINIC</span></div>
            <p style="color:rgba(255,255,255,0.7);max-width:34ch">Award-winning acupuncture &amp; Traditional Chinese Medicine in the heart of London — since 2013.</p>
          </div>
          <div>
            <h4>Contact</h4>
            <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
            <a href={CONTACT.whatsappUrl}>WhatsApp {CONTACT.whatsapp}</a>
            <a href={`tel:${CONTACT.phone}`}>{CONTACT.phone}</a>
          </div>
          <div>
            <h4>Clinics</h4>
            <a href="/#clinics">London Victoria</a>
            <a href="/#clinics">City of London</a>
            <a href="/#clinics">Online Video Consultation</a>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© 2026 AcuPro Clinic. All rights reserved.</span>
          <span>UK · United Arab Emirates · Global Online</span>
        </div>
      </div>
    </footer>

    <!-- Cookie consent (Consent Mode v2) -->
    <div id="cookie-banner" class="cookie-banner" hidden>
      <p class="cookie-text">We use cookies for analytics and marketing to improve your experience. You can accept or decline. See our <a href="/privacy/">Privacy Policy</a>.</p>
      <div class="cookie-actions">
        <button type="button" id="cookie-decline" class="btn btn-ghost">Decline</button>
        <button type="button" id="cookie-accept" class="btn btn-primary">Accept</button>
      </div>
    </div>
    <script is:inline>
      (function(){
        var KEY='acupro_consent', b=document.getElementById('cookie-banner');
        function stored(){try{return localStorage.getItem(KEY);}catch(e){return null;}}
        function save(v){try{localStorage.setItem(KEY,v);}catch(e){}}
        function apply(v){if(typeof gtag==='function')gtag('consent','update',{ad_storage:v,analytics_storage:v,ad_user_data:v,ad_personalization:v});}
        if(!stored()){ if(b) b.hidden=false; }
        function choose(v){save(v);apply(v);if(b)b.hidden=true;}
        var a=document.getElementById('cookie-accept'), d=document.getElementById('cookie-decline');
        if(a)a.addEventListener('click',function(){choose('granted');});
        if(d)d.addEventListener('click',function(){choose('denied');});
      })();
    </script>
    <script src="/enhance.js" defer is:inline></script>
  </body>
</html>
